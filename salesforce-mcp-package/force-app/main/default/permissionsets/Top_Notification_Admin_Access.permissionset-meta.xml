<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Grants full administrative access to Top Notification Control Center tab, custom objects, fields, and Apex controllers.</description>
    <label>Top Notification Admin Access</label>
    <hasActivationRequired>false</hasActivationRequired>
    
    <classAccesses>
        <apexClass>TopNotificationController</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <userPermissions>
        <enabled>true</enabled>
        <name>ViewSetup</name>
    </userPermissions>

    <userPermissions>
        <enabled>true</enabled>
        <name>RunFlow</name>
    </userPermissions>

    <tabSettings>
        <tab>Top_Notification_Admin</tab>
        <visibility>Visible</visibility>
    </tabSettings>

    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <object>Notification_Broadcast__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Notification_Broadcast_Event__e</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Notification_Broadcast__c.Title__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Notification_Broadcast__c.Message__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Notification_Broadcast__c.Theme__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Notification_Broadcast__c.Is_Active__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Notification_Broadcast__c.Is_Global__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Notification_Broadcast__c.Is_Dismissible__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Notification_Broadcast__c.Target_User_Ids__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Notification_Broadcast__c.Target_Profile_Ids__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Notification_Broadcast__c.Target_Role_Ids__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Notification_Broadcast__c.Target_Group_Ids__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Notification_Broadcast__c.Start_DateTime__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Notification_Broadcast__c.Expiration_DateTime__c</field>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
